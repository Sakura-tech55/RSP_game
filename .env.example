# ---------------------------------------------------------------------------
# Elemental RPS Arena — environment template
#
# Copy to `.env.local` and fill in what you need. Every value here is optional:
# with an empty file the app still runs, using an in-memory database, simulated
# randomness, and simulated minting. Practice Arena is fully playable that way.
#
# NEVER commit a filled-in .env.local. NEVER put a private key in any variable
# prefixed NEXT_PUBLIC_ — those are inlined into the browser bundle.
# ---------------------------------------------------------------------------

# --- app ---------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="Elemental RPS Arena"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- supabase ----------------------------------------------------------
# Leave blank to run with the in-memory repository (no accounts, no persistence).
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Server-only. Bypasses Row Level Security — never expose it to the browser,
# never prefix it with NEXT_PUBLIC_, and rotate it if it ever leaks.
SUPABASE_SERVICE_ROLE_KEY=""

# --- randomness --------------------------------------------------------
# simulated | commit-reveal | vrf
# "vrf" refuses to run until a coordinator is configured; it never falls back.
RANDOMNESS_PROVIDER="simulated"

# 32+ random bytes. Generate with: openssl rand -hex 32
# Without it the server uses an ephemeral per-process secret, so run proofs stop
# verifying after a restart.
RANDOMNESS_SERVER_SECRET=""

# Signs guest session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=""

# --- chain -------------------------------------------------------------
# demo       = no chain calls at all, simulated minting (default)
# blockchain = real testnet transactions, requires the contracts below
NEXT_PUBLIC_CHAIN_MODE="demo"

# 2021 = Ronin Saigon testnet, 11155111 = Sepolia, 31337 = Hardhat local
NEXT_PUBLIC_CHAIN_ID="2021"

# Mainnet stays disabled unless this is deliberately set to true.
NEXT_PUBLIC_ALLOW_MAINNET="false"

# Filled in by `npm run contracts:deploy:local` or :testnet
NEXT_PUBLIC_ARENA_CONTRACT_ADDRESS=""
NEXT_PUBLIC_REWARDS_CONTRACT_ADDRESS=""

# Optional: overrides the RPC URL used for server-side receipt verification.
RPC_URL_OVERRIDE=""

# --- wallets -----------------------------------------------------------
# From https://cloud.reown.com — enables the WalletConnect connector.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# --- entry fees --------------------------------------------------------
# TEST VALUES ONLY. Never hard-code production financial values in source.
NEXT_PUBLIC_ENTRY_FEE_BRONZE="0.01"
NEXT_PUBLIC_ENTRY_FEE_SILVER="0.05"
NEXT_PUBLIC_ENTRY_FEE_LEGENDARY="0.1"

# Shown in the pre-payment disclosure. Cosmetic estimate only.
NEXT_PUBLIC_ESTIMATED_GAS_NATIVE="0.0005"

# --- nft metadata ------------------------------------------------------
# Leave blank to serve metadata from this app instead of pinning to IPFS.
IPFS_PINNING_ENDPOINT=""
IPFS_PINNING_TOKEN=""

# --- rate limiting -----------------------------------------------------
RATE_LIMIT_PER_MINUTE="120"

# --- contract deployment (hardhat only; never read by the web app) ------
# Use a THROWAWAY testnet key that has never held real funds.
# .env.local is git-ignored; do not put this anywhere else.
DEPLOYER_PRIVATE_KEY=""
TREASURY_ADDRESS=""
SETTLER_ADDRESS=""
SAIGON_RPC_URL="https://saigon-testnet.roninchain.com/rpc"
SEPOLIA_RPC_URL="https://rpc.sepolia.org"
REPORT_GAS="false"
